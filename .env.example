# =============================================================================
# Hey Charlie Charters — environment variables
# Copy this file to `.env.local` and fill in real values for your environment.
# Lines marked `# REQUIRED for production` must be set before going live.
# =============================================================================

# ---- Site / canonical domain ------------------------------------------------
# Canonical production domain (must be the .com). Defaults to the .com if unset.
NEXT_PUBLIC_SITE_URL=https://heycharliecharters.com
# The legacy .co.za domain — informational only (redirect target in a later wave).
# Not read at runtime; documented here for the redirect strategy.

# ---- Clerk Auth (https://dashboard.clerk.com) -------------------------------
# REQUIRED for production — must be LIVE keys: pk_live_... and sk_live_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
# Clerk URLs (public)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Webhook secret for Clerk events (used by the webhook route).
# REQUIRED for production (generate in Clerk dashboard)
CLERK_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# ---- Database (https://console.neon.tech) -----------------------------------
# REQUIRED for production
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/dbname?sslmode=require

# ---- Payments ----------------------------------------------------------------
# Master switch for online card payments via Stripe. Off by default — bookings
# fall back to provisional EFT with a 24h hold. When enabling, set BOTH vars:
# the NEXT_PUBLIC_ one is what the browser-side booking form reads.
NEXT_PUBLIC_HCC_ONLINE_PAYMENTS_ENABLED=false
HCC_ONLINE_PAYMENTS_ENABLED=false
# Stripe keys (https://dashboard.stripe.com/apikeys). REQUIRED when online
# payments are enabled — /api/stripe/checkout throws without the secret key.
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
# Webhook signing secret for https://<domain>/api/stripe/webhooks endpoint
# (Dashboard → Developers → Webhooks). REQUIRED when online payments are enabled.
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# Banking details shown to guests for EFT payment. REQUIRED for production
# while online payments are off — without these the confirmation page tells the
# guest that banking details will be provided with the booking quotation.
HCC_BANK_NAME=
HCC_BANK_ACCOUNT_NAME=
HCC_BANK_ACCOUNT_NUMBER=
HCC_BANK_BRANCH_CODE=
HCC_BANK_ACCOUNT_TYPE=Cheque

# ---- Booking emails (https://resend.com) -------------------------------------
# When set, new bookings send an owner alert + guest confirmation email.
# When unset, emails are skipped (bookings still work).
RESEND_API_KEY=
# Verified sender for booking emails.
RESEND_FROM_EMAIL="Hey Charlie Charters <bookings@heycharliecharters.com>"
# Owner inbox for new-booking alerts; defaults to HCC_EMAIL.
HCC_BOOKING_NOTIFY_EMAIL=

# ---- Admin access ------------------------------------------------------------
# Comma-separated emails auto-promoted to admin on sign-in. Defaults to the
# owner's email hardcoded in src/lib/admin-emails.ts — set explicitly in prod.
ADMIN_EMAILS=gambew@gmail.com

# ---- Weather APIs -----------------------------------------------------------
# StormGlass.io marine data (https://stormglass.io). At least one weather key is
# required for live marine conditions; otherwise the weather service returns an
# "unavailable" state.
STORMGLASS_API_KEY=
# OpenWeatherMap fallback (https://openweathermap.org).
OPENWEATHERMAP_API_KEY=
# Open-Meteo (https://open-meteo.com) — PRIMARY marine/weather provider.
# Paid "Commercial" plan uses the customer host customer-api.open-meteo.com
# and appends &apikey=<key>. REQUIRED for production live weather.
OPEN_METEO_API_KEY=
# Customer API hosts (paid plan). Forecast uses customer-api; marine uses a separate host.
OPEN_METEO_BASE_URL=https://customer-api.open-meteo.com
OPEN_METEO_MARINE_BASE_URL=https://customer-marine-api.open-meteo.com
# Explicitly enable fabricated/mock weather data for development only.
# Defaults to false — mock data is NEVER presented as live when unset.
NEXT_PUBLIC_WEATHER_MOCK_ENABLED=false

# ---- Contact / business (HCC_ prefix) ---------------------------------------
# These default to the confirmed real values inside the app; the env vars below
# let you override them without a code change. Override only if needed.
HCC_PHONE=+27603144873
HCC_PHONE_DISPLAY=060 314 4873
# WhatsApp number as digits only (used for wa.me links).
HCC_WHATSAPP=27603144873
# REQUIRED (owner verification): confirm this inbox is monitored before launch.
HCC_EMAIL=ahoy@heycharliecharters.com
# Business hours: set to any non-empty value (e.g. "confirmed") once the owner
# has signed off the draft hours shown on the site. Until set, hours render with
# a "pending confirmation" flag. # REQUIRED for production
HCC_BUSINESS_HOURS=

# ---- Social profiles (HCC_ prefix) ------------------------------------------
# Full URLs. All REQUIRED for production when the channel is linked publicly.
# When unset the site shows a loud "REQUIRED: set <VAR>" sentinel (never "#").
HCC_FACEBOOK=
HCC_INSTAGRAM=
HCC_TWITTER=
# Optional channels:
HCC_YOUTUBE=

# ---- Permits / licences (server-only, never exposed to the client) -----------
# REQUIRED for production. Surface as "REQUIRED" sentinels until verified.
# SAMSA vessel registration / survey number.
HCC_PERMIT_SAMSA_VESSEL=
# DAFF recreational fishing permit arrangement (fishing charters).
# REQUIRED for production
HCC_PERMIT_RECFISH=
# DAFF recreational crayfish (rock lobster) permit arrangement (in season).
# REQUIRED for production
HCC_PERMIT_CRAYFISH=
